# Kopyalayıp ".env" olarak kaydedin ve gerçek değerleri girin.
# ".env" dosyasını ASLA GitHub'a yüklemeyin (.gitignore içinde zaten hariç tutuldu).

# Render'da Postgres eklediğinizde bu değeri Render otomatik sağlar
# (Internal Database URL). Yerelde test için kendi Postgres bağlantınızı yazın.
DATABASE_URL=postgres://user:password@localhost:5432/sipchat

# Rastgele, uzun ve tahmin edilemez bir değer üretin, örn:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Access token ömrü (ör. 15m, 1h, 7d)
JWT_EXPIRES_IN=7d

# (İsteğe bağlı) Yönetici API anahtarı, en az 24 karakter. Ayarlanmazsa /api/admin hiç var olmaz.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# (İsteğe bağlı) Google ile giriş: Google Cloud Console'daki "Web application" OAuth istemci kimliği
# (virgülle birden fazla olabilir). Boşsa Google ile giriş tamamen kapalıdır.
GOOGLE_CLIENT_IDS=
# (İsteğe bağlı) E-posta eşleştirme özetleri için gizli biber; boşsa JWT_SECRET kullanılır.
EMAIL_PEPPER=

# (İsteğe bağlı) Aramalar için TURN sunucusu. Üçü de doluysa istemcilere STUN'a ek olarak verilir.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Sunucu portu (Render bunu kendisi PORT env değişkeni ile sağlar)
PORT=3000

# Android uygulamasının/istemcilerin adresi (CORS için). Birden fazla
# origin'i virgülle ayırabilirsiniz. Mobil istemciler genelde Origin header
# göndermez, bu yüzden CORS mobil uygulamayı etkilemez; bu ayar öncelikle
# ileride bir web istemciniz olursa içindir.
ALLOWED_ORIGINS=http://localhost:19006
